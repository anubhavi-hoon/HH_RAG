# HH_RAG configuration example. Copy to .env and fill in locally.
# Never commit real credentials — .env is git-ignored.

# --- Backend ---

# Comma-separated browser origins allowed by CORS.
HH_RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted audio upload size in bytes.
HH_RAG_MAX_AUDIO_BYTES=10485760

# --- Frontend ---

# Set this in web/.env (see web/.env.example); the browser reads VITE_* vars only.
VITE_API_BASE_URL=http://localhost:8000

# --- Groq API Configuration ---

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Reserved for upcoming integrations ---

# Person 2: Sarvam STT + LLM generation
SARVAM_API_KEY=
LLM_API_KEY=

# Person 1: embeddings + Qdrant retrieval
QDRANT_URL=
QDRANT_API_KEY=